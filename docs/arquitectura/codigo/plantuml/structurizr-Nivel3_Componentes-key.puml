@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component,Integrado
  .Element-RWxlbWVudCxDb21wb25lbnQsSW50ZWdyYWRv {
    BackgroundColor: #16804a;
    LineColor: #0f5933;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Component,NucleoSinIntegrar
  .Element-RWxlbWVudCxDb21wb25lbnQsTnVjbGVvU2luSW50ZWdyYXI= {
    BackgroundColor: #fff8e7;
    LineColor: #c27a00;
    LineStyle: 15-15;
    LineThickness: 3;
    FontColor: #53370a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1d4ed8;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,NucleoSinIntegrar
  .Relationship-UmVsYXRpb25zaGlwLE51Y2xlb1NpbkludGVncmFy {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #c27a00;
    FontColor: #c27a00;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // AgentGuard (libreria)
  .Boundary-QWdlbnRHdWFyZCAobGlicmVyaWEp {
    BackgroundColor: #ffffff;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // AgentGuard.authorize()
  .Boundary-QWdlbnRHdWFyZC5hdXRob3JpemUoKQ== {
    BackgroundColor: #ffffff;
    LineColor: #1945a4;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Component, Integrado" <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZWdyYWRv>>

rectangle "==Component, NucleoSinIntegrar" <<Element-RWxlbWVudCxDb21wb25lbnQsTnVjbGVvU2luSW50ZWdyYXI=>>

rectangle "==Software System" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLE51Y2xlb1NpbkludGVncmFy>> : "NucleoSinIntegrar"

@enduml