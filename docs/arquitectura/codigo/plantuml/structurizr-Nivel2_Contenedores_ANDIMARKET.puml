AgenteANDIMARKET.AgentLoop --> BackendLLM <<Relationship-UmVsYXRpb25zaGlw>> : "Prompt + herramientas / tool call"
AgenteANDIMARKET.AgentLoop --> AgenteANDIMARKET.RegistryToolboxConfigA <<Relationship-UmVsYXRpb25zaGlw>> : "Config. A: ejecucion directa"
AgenteANDIMARKET.AgentLoop --> AgenteANDIMARKET.GuardedToolboxConfigB <<Relationship-UmVsYXRpb25zaGlw>> : "Config. B: llamada interceptada"
AgenteANDIMARKET.RegistryToolboxConfigA --> AgenteANDIMARKET.SQLitedenegocio <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta o cambio"
AgenteANDIMARKET.GuardedToolboxConfigB --> AgentGuardlibreria <<Relationship-UmVsYXRpb25zaGlw>> : "session + tool + arguments"
AgenteANDIMARKET.GuardedToolboxConfigB --> AgenteANDIMARKET.ConsoleApprover <<Relationship-UmVsYXRpb25zaGlw>> : "Solo si HITL"
AgenteANDIMARKET.GuardedToolboxConfigB --> AgenteANDIMARKET.SQLitedeevidencia <<Relationship-UmVsYXRpb25zaGlw>> : "Registra decision antes de ejecutar; falla cerrado"
AgenteANDIMARKET.GuardedToolboxConfigB --> AgenteANDIMARKET.SQLitedenegocio <<Relationship-UmVsYXRpb25zaGlw>> : "Solo si ALLOW o HITL aprobada"
AgentGuardlibreria --> AgenteANDIMARKET.policiesyaml <<Relationship-UmVsYXRpb25zaGlw>> : "Lee reglas"

@enduml